NODE_ENV=development
PORT=3000
POSTGRES_DB=eeelibrary
POSTGRES_USER=eeelibrary_dev
# Replace this placeholder with a unique local password, and match it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://eeelibrary_dev:replace-with-local-password@127.0.0.1:5433/eeelibrary?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
# Empty denies browser cross-origin access; native apps do not send Origin.
CORS_ORIGINS=

# Configure the real Firebase project ID to enable auth. Blank fails closed (503).
FIREBASE_PROJECT_ID=
# Optional absolute path for local ADC; prefer credentials outside the repository.
# GOOGLE_APPLICATION_CREDENTIALS=
